# Checks for finding real defects, not style.  The excluded checks only gave false alarms in this
# code: pixel arithmetic mixes int, float and size_t on purpose, offsets stay far below 2^31,
# values are clamped before rounding, and static QString constants are the Qt way.
# The tools under src/tools and the tests are not shipped; leave them out when running clang-tidy.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-throwing-static-initialization,
  -bugprone-reserved-identifier,
  -bugprone-branch-clone,
  -bugprone-incorrect-roundings,
  -bugprone-macro-parentheses,
  -bugprone-exception-escape,
  -bugprone-assignment-in-if-condition,
  -bugprone-unhandled-self-assignment,
  -bugprone-switch-missing-default-case,
  -bugprone-empty-catch,
  -bugprone-float-loop-counter,
  -bugprone-forward-declaration-namespace,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-derived-method-shadowing-base-method,
  -bugprone-copy-constructor-init,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-return-const-ref-from-parameter,
  -bugprone-signed-char-misuse,
  -performance-enum-size,
  -performance-no-automatic-move,
  -performance-noexcept-swap,
  -performance-no-int-to-ptr,
  -performance-avoid-endl
HeaderFilterRegex: '.*[/\\]src[/\\].*'
