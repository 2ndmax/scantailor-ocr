# src/resources/color_schemes/<scheme>.colors holds every color of the Light or Dark scheme, as
# "role = #rrggbb".
#
# The two schemes share one style sheet and one set of icons, in src/resources/color_schemes/template.
# Their colors are placeholders such as {{border}}, which become the color of that role.
# {{scheme}} becomes the name of the scheme, which is also the prefix of its resources. The icons in
# icons/marks/ are drawn on the accent color; their {{textOnAccent}} is written in two variants (below).
# The scheme class reads its palette and color parameters from the header
# color_schemes/<scheme>_scheme_colors.h, which has a constant for every role, in the namespace
# <scheme>_scheme_colors.
#
# generate_color_scheme(<scheme> <qrc variable>) writes the files of <scheme>, its .qrc and its
# header into the build directory, at configure time, and returns the path of the .qrc. Changing a
# template or a color table runs the configuration again.

# configure_file() writes only when the content changed, so that the resources and the sources that
# include the header are not compiled again on every configuration.
function(write_if_changed file content)
  file(WRITE "${file}.tmp" "${content}")
  configure_file("${file}.tmp" "${file}" COPYONLY)
  file(REMOVE "${file}.tmp")
endfunction()

function(generate_color_scheme scheme qrc_var)
  set(source_dir "${SCANTAILOR_RESOURCES_DIR}/color_schemes")
  set(template_dir "${source_dir}/template")
  set(colors_file "${source_dir}/${scheme}.colors")
  set(output_dir "${CMAKE_BINARY_DIR}/color_schemes/${scheme}_scheme")

  file(STRINGS "${colors_file}" color_lines)
  set(roles "")
  set(header "// Generated by cmake/ColorSchemes.cmake from ${scheme}.colors.\n#pragma once\n\n")
  string(APPEND header "namespace ${scheme}_scheme_colors {\n")
  foreach(line IN LISTS color_lines)
    if(line MATCHES "^[ \t]*$" OR line MATCHES "^[ \t]*#")
      continue()
    endif()
    if(NOT line MATCHES "^[ \t]*([A-Za-z0-9_]+)[ \t]*=[ \t]*([^ \t\r]+)[ \t\r]*$")
      message(FATAL_ERROR "${colors_file}: not \"role = color\": ${line}")
    endif()
    set(color_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
    list(APPEND roles "${CMAKE_MATCH_1}")
    string(APPEND header "inline constexpr const char* ${CMAKE_MATCH_1} = \"${CMAKE_MATCH_2}\";\n")
  endforeach()
  string(APPEND header "}  // namespace ${scheme}_scheme_colors\n")
  write_if_changed("${CMAKE_BINARY_DIR}/color_schemes/${scheme}_scheme_colors.h" "${header}")

  file(GLOB_RECURSE templates RELATIVE "${template_dir}" CONFIGURE_DEPENDS "${template_dir}/*")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${colors_file}")
  foreach(template IN LISTS templates)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${template_dir}/${template}")
    file(READ "${template_dir}/${template}" content)
    string(REPLACE "{{scheme}}" "${scheme}" content "${content}")
    foreach(role IN LISTS roles)
      string(REPLACE "{{${role}}}" "${color_${role}}" content "${content}")
    endforeach()

    # The marks on the accent color (icons/marks/) are written twice: icons/marks_light/ with
    # lightTextOnAccent and icons/marks_dark/ with darkTextOnAccent for {{textOnAccent}}. The scheme
    # class takes the one with more contrast to the accent color.
    if(template MATCHES "^icons/marks/(.*)$")
      set(outputs "icons/marks_light/${CMAKE_MATCH_1}" "icons/marks_dark/${CMAKE_MATCH_1}")
    elseif(template STREQUAL "scheme.qrc")
      set(outputs "${scheme}_scheme.qrc")
    else()
      set(outputs "${template}")
    endif()
    foreach(output IN LISTS outputs)
      set(output_content "${content}")
      if(output MATCHES "^icons/marks_(light|dark)/")
        string(REPLACE "{{textOnAccent}}" "${color_${CMAKE_MATCH_1}TextOnAccent}" output_content "${output_content}")
      endif()
      if(output_content MATCHES "{{([A-Za-z0-9_]+)}}")
        message(FATAL_ERROR "${colors_file} has no color for {{${CMAKE_MATCH_1}}} in ${template}")
      endif()
      write_if_changed("${output_dir}/${output}" "${output_content}")
    endforeach()
  endforeach()

  set(${qrc_var} "${output_dir}/${scheme}_scheme.qrc" PARENT_SCOPE)
endfunction()
