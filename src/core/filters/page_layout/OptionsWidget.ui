        <item>
         <widget class="QLabel" name="matchSizeLabel">
          <property name="toolTip">
           <string>Off: the page keeps its own size and is not part of the common size.
Fill with margins: the page is brought to the output size with margins, aligned as set under &quot;Alignment&quot;. The content keeps its size; only pages larger than an own target size are reduced.
Scale: the content is enlarged or reduced to fit the output size, within the limits below. The margins keep their size; the rest is filled with margins.</string>
          </property>
          <property name="text">
           <string>Match size:</string>
          </property>
         </widget>
        </item>
