<project layoutDirection="LTR" outputDirectory="C:/fuzz/new/out" version="10">
  <directories>
    <directory id="1" path="C:/fuzz/new/scans"/>
  </directories>
  <files>
    <file dirId="1" id="2" name="p001.tif"/>
    <file dirId="1" id="5" name="p002.tif"/>
  </files>
  <images>
    <image fileId="2" fileImage="0" id="3" subPages="1">
      <size height="3508" width="2480"/>
      <dpi horizontal="300" vertical="300"/>
    </image>
    <image fileId="5" fileImage="0" id="6" subPages="1">
      <size height="2200" width="1700"/>
      <dpi horizontal="200" vertical="200"/>
    </image>
  </images>
  <pages>
    <page id="4" imageId="3" selected="selected" subPage="single"/>
    <page id="7" imageId="6" subPage="single"/>
  </pages>
  <filters/>
  <default-params units="mm">
    <fix-orientation-params>
      <imageRotation degrees="0"/>
    </fix-orientation-params>
    <deskew-params autoOblique="0" deskewAngleDeg="2.5" detection="top-edge" mode="manual"/>
    <page-split-params detectionMethod="spine-line" layoutType="two-pages" pageOrder="LTR"/>
    <select-content-params contentDetectEnabled="1" fineTuneCorners="1" pageDetectMode="manual">
      <pageRectSize height="297" width="210"/>
      <detection borderTolerance="0" fillFactor="65" ignorePageBox="0"/>
    </select-content-params>
    <page-layout-params autoMargins="1">
      <hardMargins bottom="5" left="10" right="10" top="5"/>
      <alignment hor="center" null="0" vert="center"/>
    </page-layout-params>
    <output-params depthPerception="2" despeckleLevel="1">
      <dpi horizontal="600" vertical="600"/>
      <colorParams colorMode="mixed">
        <color-or-grayscale fillMargins="1" fillOffcut="1" fillOutsidePageBox="0" fillingColor="background" normalizeIlluminationColor="0" wienerCoef="0" wienerWinSize="5">
          <posterization-options enabled="1" forceBlackAndWhite="1" level="4" normalizationEnabled="0"/>
        </color-or-grayscale>
        <bw binarizationMethod="sauvola" morphologicalSmoothing="1" normalizeIlluminationBW="1" sauvolaCoef="0.34" savitzkyGolaySmoothing="1" thresholdAdj="0" windowSize="200" wolfCoef="0.3" wolfLowerBound="1" wolfUpperBound="254">
          <color-segmenter-options blueThresholdAdjustment="0" enabled="1" kmeans="1" kmeansColors="6" greenThresholdAdjustment="0" noiseReduction="7" posterize="0" redThresholdAdjustment="0"/>
        </bw>
      </colorParams>
      <splittingOptions originalBackground="0" splitOutput="1" splittingMode="bw"/>
      <pictureShapeOptions higherSearchSensitivity="0" pictureShape="rectangular" sensitivity="100"/>
      <dewarpingOptions mode="auto" postDeskew="1" postDeskewAngle="0"/>
    </output-params>
    <processing-options>
      <tiff bw="4" color="5" jpegQuality="85" palette="5"/>
      <color-detection minColor="3" minPicture="5" pictureZones="0"/>
      <black-on-white detection="1" output="1"/>
      <pdf backgroundScale="2" bitonalCompression="5" colorCompression="2" colorQuality="85" paletteCompression="1" paletteQuality="85" pdfA="1"/>
      <ocr enabled="1" languages="deu+eng" pageLayout="0"/>
    </processing-options>
  </default-params>
</project>
