<project layoutDirection="LTR" outputDirectory="out" version="10">
  <processing-options>
    <tiff bw="4" color="5" jpegQuality="85" palette="5"/>
    <color-detection minColor="3" minPicture="5" pictureZones="0"/>
    <black-on-white detection="1" output="1"/>
    <pdf backgroundScale="2" bitonalCompression="5" colorCompression="2" colorQuality="85" paletteCompression="1" paletteQuality="85" pdfA="1"/>
    <ocr enabled="1" languages="deu+eng" pageLayout="0"/>
  </processing-options>
  <default-params units="mm">
    <fix-orientation-params>
      <imageRotation degrees="0"/>
    </fix-orientation-params>
    <deskew-params autoOblique="0" deskewAngleDeg="0" detection="content" mode="auto"/>
    <page-split-params detectionMethod="spine-line" layoutType="auto-detect" pageOrder="LTR"/>
    <select-content-params contentDetectEnabled="1" fineTuneCorners="0" pageDetectMode="disabled">
      <pageRectSize height="297" width="210"/>
      <detection borderTolerance="0" fillFactor="65" ignorePageBox="0"/>
    </select-content-params>
    <page-layout-params autoMargins="0">
      <hardMargins bottom="5" left="10" right="10" top="5"/>
      <alignment hor="center" null="0" vert="center"/>
    </page-layout-params>
    <output-params depthPerception="2" despeckleLevel="1">
      <dpi horizontal="600" vertical="600"/>
      <colorParams colorMode="bw">
        <color-or-grayscale fillMargins="1" fillOffcut="1" fillOutsidePageBox="0" fillingColor="background" normalizeIlluminationColor="0" wienerCoef="0" wienerWinSize="5">
          <posterization-options enabled="0" forceBlackAndWhite="1" level="4" normalizationEnabled="0"/>
        </color-or-grayscale>
        <bw binarizationMethod="otsu" morphologicalSmoothing="1" normalizeIlluminationBW="1" sauvolaCoef="0.34" savitzkyGolaySmoothing="1" thresholdAdj="0" windowSize="200" wolfCoef="0.3" wolfLowerBound="1" wolfUpperBound="254">
          <color-segmenter-options blueThresholdAdjustment="0" enabled="0" greenThresholdAdjustment="0" noiseReduction="7" posterize="0" redThresholdAdjustment="0"/>
        </bw>
      </colorParams>
      <splittingOptions originalBackground="0" splitOutput="0" splittingMode="bw"/>
      <pictureShapeOptions higherSearchSensitivity="0" pictureShape="free" sensitivity="100"/>
      <dewarpingOptions mode="off" postDeskew="1" postDeskewAngle="0"/>
    </output-params>
  </default-params>
  <directories>
    <directory id="1" path="scans"/>
    <directory id="9" path="../other"/>
  </directories>
  <files>
    <file dirId="1" id="2" name="p001.tif"/>
    <file dirId="1" id="5" name="p002.tif"/>
    <file dirId="9" id="10" name="p001.tif"/>
    <file dirId="1" id="13" name="cover.jp2"/>
  </files>
  <images>
    <image fileId="2" fileImage="0" id="3" subPages="1">
      <size height="3508" width="2480"/>
      <dpi horizontal="300" vertical="300"/>
    </image>
    <image fileId="5" fileImage="1" id="6" subPages="2">
      <size height="3508" width="4960"/>
      <dpi horizontal="300" vertical="300"/>
    </image>
    <image fileId="10" fileImage="0" id="11" subPages="1">
      <size height="2200" width="1700"/>
      <dpi horizontal="200" vertical="150"/>
    </image>
    <image fileId="13" fileImage="0" id="14" subPages="1">
      <size height="600" width="800"/>
      <dpi horizontal="0" vertical="0"/>
    </image>
  </images>
  <pages>
    <page id="4" imageId="3" subPage="single"/>
    <page id="7" imageId="6" selected="selected" subPage="left"/>
    <page id="8" imageId="6" subPage="right"/>
    <page id="12" imageId="11" subPage="single"/>
    <page id="15" imageId="14" subPage="single"/>
  </pages>
  <file-name-disambiguation>
    <mapping file="2" label="0"/>
    <mapping file="10" label="1"/>
  </file-name-disambiguation>
  <filters/>
</project>
