# All colors of the Dark scheme, read by cmake/ColorSchemes.cmake. Each {{role}} in the shared style
# sheet and icons in template/ becomes the color given here; DarkColorScheme reads its palette and
# color parameters from the generated header dark_scheme_colors.h.

# Borders of hovered, focused and checked controls, the selected thumbnail and the marks on
# thumbnails: the default accent color (DEFAULT_ACCENT_COLOR). A chosen accent color replaces this
# value wherever it is in the style sheet, so no other role may have it.
accent = #0f64d2

# Dock titles, tabs, status bar and table headers.
barBackground = #424242

# Borders of buttons, fields and check boxes.
controlBorder = #666666

# Border of the default button.
defaultButtonBorder = #939393

# Background of disabled controls.
disabledControlBackground = #4d4d4d

# Borders of disabled controls.
disabledControlBorder = #5e5e5e

# Disabled menu items and disabled icons.
disabledText = #989898

# Borders of docks, tabs, trees and tables.
frameBorder = #383838

# Border of group boxes.
groupBoxBorder = #424242

# Hovered tabs and dock buttons.
hoverBackground = #4f4f4f

# Tree branches and the buttons of docks.
iconForeground = #DDDDDD

# Background of the image views.
imageViewBackground = #282828

# Disabled check box or radio button that is checked.
indicatorCheckedDisabledBackground = #707070

# Pressed check box or radio button that is checked.
indicatorCheckedPressedBackground = #868686

# Check mark and radio dot.
indicatorMark = #454545

# Check mark and radio dot when disabled.
indicatorMarkDisabled = #4d4d4d

# Check mark and radio dot while pressed.
indicatorMarkPressed = #363636

# Pressed check box or radio button that is unchecked.
indicatorUncheckedPressedBackground = #363636

# Border of selected and pressed menu bar items.
menuBarItemBorder = #636363

# Selected menu bar item.
menuBarItemSelectedBackground = #474747

# Checked marks in menus.
menuIndicatorChecked = #d2d2d2

# Pressed and checked buttons, menu bar line, menu separators.
pressedBackground = #383838

# Filled part of progress bars.
progressBarChunk = #3399ff

# Arrows of scroll bars.
scrollBarArrow = #8c8c8c

# Groove of scroll bars.
scrollBarBackground = #494949

# Pressed arrow buttons of scroll bars.
scrollBarButtonPressed = #1a1a1a

# Handle of scroll bars.
scrollBarHandle = #696969

# Selected items of disabled trees and tables.
selectedDisabledItemBackground = #5d5d5d

# Selected text in fields and lists.
selectionBackground = #3399ff

# Groove of sliders.
sliderGroove = #757575

# Handle of sliders.
sliderHandle = #F0F0F0

# Border of the slider handle.
sliderHandleBorder = #212121

# Arrows of spin boxes and combo boxes.
spinBoxArrow = #C1C1C1

# Pressed arrows of spin boxes and combo boxes.
spinBoxArrowPressed = #8C8C8C

# Border of tool tips.
toolTipBorder = #383838

# ---- Palette of the scheme (DarkColorScheme), set in C++ ----

# Background of windows and dialogs.
window = #535353

# Text of windows and controls.
windowText = #DDDDDD

# Text of disabled controls.
disabledWindowText = #989898

# Background of fields, lists and buttons.
base = #454545

# Background of disabled fields, lists and buttons.
disabledBase = #4D4D4D

# Background of tool tips.
toolTipBase = #424242

# Text of tool tips.
toolTipText = #DDDDDD

# Shades of frames and bevels that the Fusion style draws, from light to shadow.
light = #666666
midlight = #535353
dark = #404040
mid = #333333
shadow = #262626

# Text that has to stand out from its background.
brightText = #FC5248

# Links.
link = #4F95FC

# Selected items in lists and trees.
highlight = #6B6B6B

# Selected items in disabled lists and trees.
disabledHighlight = #5D5D5D

# ---- Colors of what the style sheet doesn't reach (color parameters), set in C++ ----

# Names under the thumbnails.
thumbnailItemText = #DDDDDD

# Name under the thumbnail that leads a selection: background and text.
thumbnailSelectionLeaderBackground = #7A7A7A
thumbnailSelectionLeaderText = #ffffff

# Border of the panel for creating or opening a project.
openNewProjectBorder = #535353

# Veil over the image view while a page is processed.
processingIndicationFade = #282828

# Invalid resolution in the "Fix DPI" dialog.
fixDpiDialogErrorText = #F34941
