# All colors of the Light scheme, read by cmake/ColorSchemes.cmake. Each color has one meaning, and the
# Light and Dark schemes give each meaning a color of their own. Each {{meaning}} in the shared style
# sheet and icons in template/ becomes the color given here; LightColorScheme reads its palette and
# color parameters from the generated header light_scheme_colors.h.

# Background of windows, dialogs, the menu bar and the selected tab.
window = #f0f0f0

# Background of text and of what holds it: fields, lists, trees, tables, buttons, menus, tool tips.
content = #ffffff

# Dock titles, tabs, the status bar, table headers and the groove of scroll bars.
bar = #e3e3e3

# Background behind the pages in the image views, and the veil over them while a page is processed.
imageView = #909090

# All borders and lines, also of disabled controls; tree lines, the handle of scroll bars, the groove
# of sliders.
border = #ababab

# Text and icons; the border of the default button; names under the thumbnails.
text = #303030

# Text and icons of disabled controls; the filling of checked, disabled check boxes.
disabledText = #909090

# Text and marks on the accent color: selected text and items, check marks. Of these two, the one
# with more contrast to the accent color is taken, also to a chosen one.
lightTextOnAccent = #ffffff
darkTextOnAccent = #262626

# Error messages.
error = #d40000

# Focus, hover and pressed borders, selected text and items, checked boxes, progress, the selected
# thumbnail. The style sheet takes it from the palette (palette(highlight)), and so does a chosen
# accent color.
accent = #1d73df

# Links in messages.
link = #0f64d2

# Element under the mouse: tabs, dock buttons, menu items.
hover = #d9d9d9

# Pressed and checked buttons, an open menu, a pressed unchecked box.
pressed = #cccccc

# Selected items of lists and trees that are disabled or in an inactive window.
inactiveSelection = #d9d9d9
