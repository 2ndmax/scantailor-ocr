# All colors of the Light scheme, read by cmake/ColorSchemes.cmake. Each {{role}} in the shared style
# sheet and icons in template/ becomes the color given here; LightColorScheme reads its palette and
# color parameters from the generated header light_scheme_colors.h.

# Borders of hovered, focused and checked controls, the selected thumbnail and the marks on
# thumbnails: the default accent color (DEFAULT_ACCENT_COLOR). A chosen accent color replaces this
# value wherever it is in the style sheet, so no other role may have it.
accent = #1e76e3

# Dock titles, tabs, status bar and table headers.
barBackground = #dbdbdb

# Borders of buttons, fields and check boxes.
controlBorder = #cccccc

# Border of the default button.
defaultButtonBorder = #4b4b4b

# Background of disabled fields, lists, buttons and other controls (palette).
disabledBackground = #fafafa

# Borders of disabled controls.
disabledControlBorder = #dedede

# Selected items of disabled lists, trees and tables (palette).
disabledSelectionBackground = #dfdfdf

# Text of disabled controls (palette), disabled menu items and disabled icons.
disabledText = #909090

# Borders of docks, tabs, trees and tables.
frameBorder = #cccccc

# Border of group boxes.
groupBoxBorder = #d1d1d1

# Hovered tabs and dock buttons.
hoverBackground = #ebebeb

# Background of the image views, and the veil over them while a page is processed.
imageViewBackground = #939393

# Disabled check box or radio button that is checked.
indicatorCheckedDisabledBackground = #b5b5b5

# Pressed check box or radio button that is checked.
indicatorCheckedPressedBackground = #555555

# Check mark and radio dot.
indicatorMark = #fafafa

# Check mark and radio dot when disabled.
indicatorMarkDisabled = #f0f0f0

# Check mark and radio dot while pressed.
indicatorMarkPressed = #ffffff

# Pressed check box or radio button that is unchecked.
indicatorUncheckedPressedBackground = #b5b5b5

# Border of selected and pressed menu bar items.
menuBarItemBorder = #dbdbdb

# Selected menu bar item.
menuBarItemSelectedBackground = #fafafa

# Checked marks in menus.
menuIndicatorChecked = #6c6c6c

# Pressed and checked buttons, menu bar line, menu separators.
pressedBackground = #bfbfbf

# Filled part of progress bars.
progressBarChunk = #5d9bf3

# Arrows of scroll bars.
scrollBarArrow = #939393

# Groove of scroll bars.
scrollBarBackground = #e3e3e3

# Pressed arrow buttons of scroll bars.
scrollBarButtonPressed = #d9d9d9

# Handle of scroll bars.
scrollBarHandle = #bdbdbd

# Selected text in fields and lists.
selectionBackground = #3399ff

# Groove of sliders.
sliderGroove = #cccccc

# Handle of sliders.
sliderHandle = #faffff

# Border of the slider handle.
sliderHandleBorder = #a4a4a4

# Arrows of spin boxes and combo boxes.
spinBoxArrow = #585858

# Pressed arrows of spin boxes and combo boxes.
spinBoxArrowPressed = #303030

# Text of windows and controls (palette), tree branches and the buttons of docks.
text = #303030

# Border of tool tips.
toolTipBorder = #000000

# ---- Palette of the scheme (LightColorScheme), set in C++ ----

# Background of windows and dialogs.
window = #F0F0F0

# Background of fields, lists and buttons.
base = #FCFCFC

# Background of tool tips.
toolTipBase = #FFFFCD

# Text of tool tips.
toolTipText = #000000

# Shades of frames and bevels that the Fusion style draws, from light to shadow.
light = #ffffff
midlight = #F0F0F0
dark = #DADADA
mid = #CCCCCC
shadow = #BEBEBE

# Text that has to stand out from its background.
brightText = #F40000

# Links.
link = #0000FF

# Selected items in lists and trees.
highlight = #B5B5B5

# ---- Colors of what the style sheet doesn't reach (color parameters), set in C++ ----

# Names under the thumbnails.
thumbnailItemText = #000000

# Name under the thumbnail that leads a selection: background and text.
thumbnailSelectionLeaderBackground = #4A4A4A
thumbnailSelectionLeaderText = #ffffff

# Border of the panel for creating or opening a project.
openNewProjectBorder = #CCCCCC

# Invalid resolution in the "Fix DPI" dialog.
fixDpiDialogErrorText = #FB0000
