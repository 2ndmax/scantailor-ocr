[Desktop Entry]
Version=1.0
X-ScanTailor-OCR-Version=@VERSION@
Name=ScanTailor OCR
Comment=Post-process scanned pages and export them as searchable PDF with OCR
Exec=scantailor-ocr %f
Icon=scantailor-ocr
Terminal=false
X-MultipleArgs=false
Type=Application
Categories=Graphics;
MimeType=application/x-scantailor-project;
