/* This file is a template for version.h, for use with CMake. */

#ifndef SCANTAILOR_VERSION_H_
#define SCANTAILOR_VERSION_H_

#define VERSION "1.0.10"
#define VERSION_QUAD ""  // Must be "x.x.x.x" or an empty string.
#define PROJECT_VERSION 10
// Project files of ScanTailor Advanced 1.2 and of older versions of this program. They are
// still read, but saved as PROJECT_VERSION, so that ScanTailor Advanced no longer opens them.
#define PROJECT_VERSION_UPSTREAM 4
// Project files of ScanTailor Advanced up to 1.1, read in the same way.
#define PROJECT_VERSION_UPSTREAM_OLD 3

#endif
